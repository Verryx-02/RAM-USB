@startuml
!include _style.puml

title Deployment Diagram

skinparam nodesep 30
skinparam ranksep 110
skinparam ArrowFontSize 11
skinparam roundCorner 12
skinparam linetype ortho

' node<<service>> / node<<infra>> come from _style.puml's "blu notte" palette
' unchanged — no local override needed here.
skinparam node<<public>> {
  BackgroundColor #2A4A7F/#1B3A6B
  BorderColor #C9A227
  LineThickness 2.5
  FontColor #F0F0F0
}
skinparam node<<external>> {
  BackgroundColor #C7D3DE/#A9BAC9
  BorderColor #5C7089
  FontColor #14202B
}
skinparam node<<docker>> {
  BackgroundColor #DDE4EA
  BorderColor #8C9BAA
  LineThickness 1
  FontColor #5A6B7A
}
skinparam cloud {
  BackgroundColor #D8E6F2/#B8D4E3
  BorderColor #3A6EA5
  FontColor #14304D
}

node "**User-Client**\n[laptop/desktop]\nrestic + SSH key + Tailscale" as UserClient <<external>>

node "Public VPS\n(dedicated, NET-F-01)" as EntryHubVPS {
  node "**Entry-Hub**\n[Go]\nHTTPS :443" as EntryHub <<public>>
}

node "Public VPS\n(dedicated, NM-F-14)" as HeadscaleVPS {
  node "**Headscale**\ncoordination + admin API" as Headscale <<public>>
}

cloud "**Headscale Mesh VPN**\nprivate network, mTLS\ncerts from private CA, TLS 1.3" as Mesh

' hidden-edge chain to force a clean left-to-right rank for User-Client's
' two public entry points: Entry-Hub before Headscale, matching the
' registration-then-mesh-join reading order (CL-F-04).
UserClient -[hidden]right- EntryHubVPS
EntryHubVPS -[hidden]right- HeadscaleVPS

node "Proxmox VE Host" as Proxmox {

  rectangle "LXC Containers" as LXCGroup #line.dashed;line:AAAAAA;back:FDFDFD {
    together {
      node " " as SecuritySwitchDocker <<docker>> {
        node "**Security-Switch**\n[Go]" as SecuritySwitch <<service>>
      }
      node " " as CADocker <<docker>> {
        node "**Certificate-Authority**\n[smallstep/certificates]" as CA <<certAuthority>>
      }
      node " " as MosquittoDocker <<docker>> {
        node "**MQTT-Broker**\n[Mosquitto]" as Mosquitto <<infra>>
      }
      node " " as MetricsCollectorDocker <<docker>> {
        node "**Metrics-Collector**\n[Go]" as MetricsCollector <<infra>>
      }
      node " " as GrafanaDocker <<docker>> {
        node "**Metrics-Visualizer**\n[Grafana]" as Grafana <<infra>>
      }
    }

    SecuritySwitchDocker -[hidden]right- CADocker
    CADocker -[hidden]right- MosquittoDocker
    MosquittoDocker -[hidden]right- MetricsCollectorDocker
    MetricsCollectorDocker -[hidden]right- GrafanaDocker
  }

  rectangle "KVM Virtual Machines\n(RNF-ORG-04)" as KVMGroup #line.dashed;line:AAAAAA;back:FDFDFD {
    together {
      node " " as DatabaseVaultDocker <<docker>> {
        node "**Database-Vault**\n[Go]" as DatabaseVault <<service>>
      }
      node " " as StorageServiceDocker <<docker>> {
        node "**Storage-Service**\n[Go, SFTP]" as StorageService <<service>>
      }
      node " " as NetworkManagerDocker <<docker>> {
        node "**Network-Manager**\n[Go]" as NetworkManager <<service>>
      }
    }

    DatabaseVaultDocker -[hidden]right- StorageServiceDocker
    StorageServiceDocker -[hidden]right- NetworkManagerDocker
  }

  SecuritySwitchDocker -[hidden]down- DatabaseVaultDocker
}

' Proxmox is pinned onto its own rank strictly below both public VPS boxes
' (not same-rank/beside them) specifically because Network-Manager's real
' REST API edge to Headscale is the only real edge that reaches outside
' Proxmox. Graphviz treats a same-rank ("flat") edge between two nodes at
' the same rank as something to actively avoid, so whichever hidden-edge
' shape was tried to keep Proxmox beside Entry-Hub/Headscale in the same
' row got silently overridden and Headscale ended up back next to Proxmox's
' right edge. Forcing Proxmox down onto the next rank instead sidesteps
' that conflict entirely and reliably keeps Entry-Hub before Headscale.
EntryHubVPS -[hidden]down- Proxmox
HeadscaleVPS -[hidden]down- Proxmox

UserClient -down-> EntryHub : HTTPS :443 (public internet)\nLet's Encrypt cert
UserClient -right-> Headscale : joins after bootstrap\n(pre-auth key, CL-F-04)
Headscale ..> Mesh : coordinates only\n(cannot itself be a member, NM-F-12)
NetworkManagerDocker -up-> Headscale : REST API :443 (mTLS + token)\npre-auth key / ACL policy

legend
  Entry-Hub and Headscale are the only publicly reachable nodes (NET-F-01).
  Every other node communicates exclusively over
  the mesh, mutually authenticated with private-CA certificates.
end legend

@enduml
