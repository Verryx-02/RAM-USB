#!/bin/sh
# s6-rc runs this after ../run exits, before respawning it. Without a
# finish script, a plain longrun respawns instantly on any exit - fine for
# a transient error, but "run"'s only failure mode today is main.go's
# os.Exit(1) after a fatal startup error (e.g. an already-consumed,
# single-use CA-F-04 bootstrap token: RAM_USB_CA_BOOTSTRAP_TOKEN can never
# succeed twice, so every respawn after that point is guaranteed to fail
# identically). Left unthrottled, that produced a sub-second crash loop
# (confirmed live 2026-07-24: one "fatal startup error" log line per
# second, indefinitely) that spammed logs, kept hammering the CA with
# doomed requests, and gave an operator no real window to notice and fix
# it (mint a fresh token, recreate the container).
#
# $1 is the run script's exit code, or 256 if it was killed by a signal
# (s6-overlay convention - $2 then carries the signal number). A clean
# container stop (SIGTERM) must not be delayed, so only a genuine nonzero
# exit code gets the backoff.
if [ "$1" -ne 0 ] && [ "$1" -ne 256 ]; then
  sleep 30
fi
